# ==========================================
# SeMarketplace Environment Configuration
# ==========================================

# --- Frontend Settings ---
VITE_API_URL=/api
VITE_USE_MOCK=false
VITE_APP_NAME="SeMarketplace"
VITE_CURRENCY="Rp"

# --- Backend Security & Credentials ---
# Ganti dengan secret key acak yang panjang untuk produksi
JWT_SECRET=super_secret_jwt_key_please_change_in_production_99xyz

# Akun Super Admin (Otomatis dibuat/disinkronkan saat container backend start)
ADMIN_EMAIL=admin@semarket.com
ADMIN_PASSWORD=GantiPasswordKuat123!

# --- PostgreSQL Enterprise Database ---
POSTGRES_USER=semarket
POSTGRES_PASSWORD=semarket_secure_pass_2026
POSTGRES_DB=semarketplace
